# Polystrukt Environment Configuration

# Server & Application Environment (development | production)
NODE_ENV=development

# Server Port (hardcoded to 3000 in container environment)
PORT=3000

# JSON Web Token Cryptographic Secret (used for signing session tokens)
# Provide a 64+ char random hex string in production: openssl rand -hex 32
JWT_SECRET=

# Google Gemini API Key (server-side only, never exposed to client)
GEMINI_API_KEY=

# Optional: Password for demo/guest account seeding
DEMO_USER_PASSWORD=

# Firebase Configuration (Server and Client)
FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
